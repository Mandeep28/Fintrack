# FinTrack Environment Variables Blueprint for Production

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-a-strong-32-byte-secret-via-openssl-rand-hex-32

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/fintrack?sslmode=require

# Google OAuth (Optional - enable Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Transactional Email (SMTP - Resend, SendGrid, Brevo, AWS SES, or Gmail SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key
EMAIL_FROM="FinTrack" <noreply@your-domain.com>

# AI Financial Diagnosis & Insights (Optional)
AI_MODEL=openrouter/free
OPENAI_API_KEY=your-openai-api-key
# Or OpenRouter:
# OPENROUTER_API_KEY=your-openrouter-api-key

# Production Environment
NODE_ENV=production
