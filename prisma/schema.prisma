datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  password            String?
  provider            String?   @default("credentials")
  role                String    @default("USER")
  status              String    @default("ACTIVE")
  deletedAt           DateTime?
  image               String?
  phoneNumber         String?
  bio                 String?
  isVerified          Boolean   @default(true)
  emailVerified       DateTime?
  verificationCode    String?
  verificationExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  rooms        RoomMember[]
  expenses     Expense[]
  createdRooms Room[]       @relation("CreatedBy")
  budgets         Budget[]
  categories      Category[]
  goals           Goal[]
  financialHealth FinancialHealth?
  categoryKeywords CategoryKeyword[]
}

model Room {
  id        String   @id @default(cuid())
  name      String
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  RoomMember[]
  expenses Expense[]
}

model RoomMember {
  id      String @id @default(cuid())
  roomId  String
  userId  String
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Expense {
  id        String   @id @default(cuid())
  roomId    String?
  userId    String
  amount    Decimal
  category  String
  note      String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  amount    Decimal
  month     String?  // Optional: "YYYY-MM" (e.g. "2026-09") for monthly budget, null for default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  title         String
  targetAmount  Decimal
  currentAmount Decimal  @default(0)
  category      String
  type          String   @default("SAVINGS") // "SAVINGS" (e.g. buying smartphone) or "DEBT" (e.g. loan payoff)
  deadline      DateTime?
  status        String   @default("ACTIVE")  // "ACTIVE" or "COMPLETED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  amount    Decimal
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model FinancialHealth {
  id           String   @id @default(cuid())
  userId       String   @unique
  score        Int
  tier         String
  pillars      Json
  summary      String   @db.Text
  insights     Json
  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CategoryKeyword {
  id        String   @id @default(cuid())
  keyword   String
  category  String
  userId    String?
  source    String   @default("SYSTEM") // "SYSTEM" | "AI" | "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([keyword, userId])
  @@index([keyword])
  @@index([userId])
  @@index([category])
}
